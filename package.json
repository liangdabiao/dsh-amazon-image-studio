{
  "name": "dsh-amazon-image-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "亚马逊图片工作台：Listing 图（MAIN+PT01-06，7-12 张）与四套 A+ 模块 AI 策划、逐张生图 Prompt 组装、合规自检、色卡风格板、6 站点本地化；四服务商生图适配（火山 Seedream / OpenAI 兼容 / 阿里百炼）+ dreamina/apiz CLI 兜底；AI 人物媒体 XMP 打标；侧栏「亚马逊图片」工作台与策划/生成历史持久化。方法论移植自 Ali-Aria/amazon-image-studio（MIT）。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lab",
    "lib",
    "skills",
    "assets",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "amazon",
    "listing",
    "aplus",
    "product-image",
    "seedream"
  ],
  "scripts": {
    "test": "node test/lib.test.mjs",
    "selftest": "node scripts/selftest.mjs",
    "sandbox": "bash scripts/dev-sandbox.sh"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "license": "MIT"
}
